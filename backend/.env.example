# Copy to .env and adjust. The service reads these variables (prefix AUDIOBOOK_) at start-up.
# Lines starting with '#' are comments. Never commit a real .env file.

# --- Environment -------------------------------------------------------------------------------
# development | test | production. In production the fake speech provider is refused and an API key is required.
AUDIOBOOK_ENVIRONMENT=development
AUDIOBOOK_LOG_LEVEL=INFO

# --- Storage -----------------------------------------------------------------------------------
# Directory for the SQLite database and temporary audio chunks (relative paths resolve from the working directory).
AUDIOBOOK_DATA_DIR=data
# Optional. Defaults to SQLite inside DATA_DIR, e.g. sqlite:///data/audiobook.db
# AUDIOBOOK_DATABASE_URL=

# --- Access ------------------------------------------------------------------------------------
# Required in production. Clients send it as the X-API-Key header when they create a book.
# AUDIOBOOK_API_KEY=change-me-to-a-long-random-value

# --- Speech provider ---------------------------------------------------------------------------
# fake: deterministic offline audio for development and tests. azure: Azure AI Speech (neural TTS).
AUDIOBOOK_TTS_PROVIDER=fake
# Required when TTS_PROVIDER=azure.
# AUDIOBOOK_AZURE_SPEECH_KEY=
# Lower-case region identifier, for example westeurope or eastus.
# AUDIOBOOK_AZURE_SPEECH_REGION=
# mp3 (default), ogg-opus or riff-wav output: audio-24khz-48kbitrate-mono-mp3 | audio-16khz-32kbitrate-mono-mp3 |
# ogg-24khz-16bit-mono-opus | riff-24khz-16bit-mono-pcm
AUDIOBOOK_AZURE_OUTPUT_FORMAT=audio-24khz-48kbitrate-mono-mp3
# JSON list. The first voice is the default when a client does not choose one.
AUDIOBOOK_ALLOWED_VOICES=["uz-UZ-MadinaNeural","uz-UZ-SardorNeural"]
AUDIOBOOK_TTS_TIMEOUT_SECONDS=30
AUDIOBOOK_TTS_MAX_ATTEMPTS=3
AUDIOBOOK_TTS_RETRY_BASE_DELAY=1.0

# --- Limits (cost and abuse protection) --------------------------------------------------------
AUDIOBOOK_MAX_REQUEST_BYTES=2000000
AUDIOBOOK_MAX_TRANSCRIPT_CHARS=200000
AUDIOBOOK_MAX_CHUNKS_PER_JOB=3000
AUDIOBOOK_MAX_CHUNK_CHARS=600
# Hours a book is kept on the server if the device never acknowledges it.
AUDIOBOOK_JOB_TTL_HOURS=24

# --- Concurrency -------------------------------------------------------------------------------
AUDIOBOOK_WORKER_THREADS=2
AUDIOBOOK_TTS_CONCURRENCY=4
AUDIOBOOK_PURGE_INTERVAL_SECONDS=900
