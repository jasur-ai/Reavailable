{
  "expo": {
    "name": "Reavailable",
    "slug": "reavailable",
    "version": "0.2.3",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "reavailable",
    "ios": {
      "bundleIdentifier": "uz.reavailable.app",
      "supportsTablet": false
    },
    "android": {
      "package": "uz.reavailable.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#1F6F5C",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Reavailable uses the microphone only to hear the English voice commands (next, repeat, pause, resume) while voice control is on.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ],
      "expo-document-picker",
      "expo-secure-store",
      [
        "react-native-vosk",
        {
          "models": [
            "assets/model-en-us"
          ],
          "iOSMicrophonePermission": "Reavailable uses the microphone only to hear the English voice commands while voice control is on."
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
